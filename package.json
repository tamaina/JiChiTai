{
  "name": "municipality-typing-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "pnpm ime-dictionaries:build",
    "dev": "vite dev",
    "build": "pnpm ime-dictionaries:build && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "geo:build": "node --max-old-space-size=4096 scripts/build-national-dataset.mjs",
    "area-codes:build": "node scripts/build-area-codes.mjs",
    "emblems:build": "node scripts/build-emblems.mjs",
    "postal-prefixes:build": "node scripts/build-postal-prefixes.mjs",
    "ime-dictionaries:build": "node scripts/build-ime-dictionaries.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && vitest run --config vitest.worker.config.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:electron": "env -u ELECTRON_RUN_AS_NODE PLAYWRIGHT_USE_ELECTRON=1 xvfb-run -a playwright test --workers=1",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "hono": "^4.13.1",
    "ts-fsrs": "^5.4.1",
    "valibot": "^1.4.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.0",
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "electron": "^43.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "fflate": "^0.8.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "jpn-atlas": "^1.0.2",
    "polygon-clipping": "^0.15.7",
    "prettier": "^3.9.6",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.122.0"
  }
}
